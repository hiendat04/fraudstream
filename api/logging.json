{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "skip_probes": {"()": "fraudstream_api.logs.SkipProbes"}
  },
  "formatters": {
    "json": {"()": "fraudstream_api.logs.JsonFormatter"}
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "json",
      "filters": ["skip_probes"]
    }
  },
  "loggers": {
    "uvicorn": {"handlers": ["stdout"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": ["stdout"], "level": "INFO", "propagate": false},
    "fraudstream_api": {"handlers": ["stdout"], "level": "INFO", "propagate": false}
  },
  "root": {"handlers": ["stdout"], "level": "WARNING"}
}
