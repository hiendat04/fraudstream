{
  "fraudstream_postgres": {
    "conn_type": "postgres",
    "host": "${POSTGRES_HOST}",
    "login": "${POSTGRES_USER}",
    "password": "${POSTGRES_PASSWORD}",
    "schema": "${POSTGRES_DB}",
    "port": 5432
  },
  "fraudstream_kafka": {
    "conn_type": "generic",
    "host": "kafka",
    "port": 29092,
    "extra": {
      "bootstrap_servers": "${FRAUDSTREAM_KAFKA_BOOTSTRAP_SERVERS}"
    }
  }
}
