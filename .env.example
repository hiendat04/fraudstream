# Local (host-side) environment for CLI commands run OUTSIDE Docker.
#
# Docker Compose also auto-loads this file, but only to substitute ${VAR}
# placeholders inside docker-compose.yml itself. The values a container's
# processes actually see come from that service's own `environment:` block,
# which hardcodes Docker-network addresses (postgres, minio:9000, redis).
# So the hostnames below are deliberately NOT the ones containers use --
# from the host you reach the services through their published ports.
#
# Usage (no `export` needed) -- the path is relative to YOUR CURRENT DIRECTORY:
#   from repo root:                uv run --env-file .env python -m fraudstream.jobs.silver.transactions
#   from feature_store/:           uv run --env-file ../.env python -m fraudstream_feast.stream_push
#   from feature_store/feature_repo/:  uv run --env-file ../../.env feast apply
# Or independent of where you are:
#   uv run --env-file "$(git rev-parse --show-toplevel)/.env" feast apply

# --- PostgreSQL (serving tables + the Iceberg JDBC catalog + Feast registry)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraudstream
POSTGRES_USER=fraudstream
POSTGRES_PASSWORD=fraudstream_local_password

# --- Redis (Feast online store)
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MinIO (S3A object storage)
# Port 19000 is the published host port; containers use http://minio:9000.
# If you change these, change MINIO_ROOT_USER/MINIO_ROOT_PASSWORD too --
# docker-compose.yml reads those separate names when starting MinIO itself.
MINIO_ENDPOINT=http://localhost:19000
MINIO_ACCESS_KEY=fraudstream
MINIO_SECRET_KEY=fraudstream_local_password

# --- Iceberg lakehouse
FRAUDSTREAM_WAREHOUSE_URI=s3a://fraudstream/warehouse
FRAUDSTREAM_ICEBERG_CATALOG_NAME=iceberg
FRAUDSTREAM_ICEBERG_CATALOG_TYPE=jdbc

# --- Kafka (9092 is the EXTERNAL listener; containers use kafka:29092)
FRAUDSTREAM_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Feast
FEAST_SPARK_MASTER=local[4]
FEAST_REPO_PATH=feature_store/feature_repo

# --- Feast stream-push tuning (read by the feast-stream-push service)
FEAST_PUSH_BATCH_SIZE=10000
FEAST_PUSH_FLUSH_SECONDS=30

# --- Jenkins (docker compose --profile ci). Read as secret files, so builds
# do not inherit them. Also uses POSTGRES_* and MINIO_* above.
JENKINS_ADMIN_PASSWORD=change-me
GITHUB_USER=
# A personal access token with read access to the repository.
GITHUB_TOKEN=

#Gateway: basic auth for every service behind NGINX
GATEWAY_USER=fraudstream
GATEWAY_PASSWORD=change-me
