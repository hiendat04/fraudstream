services:
  mlflow:
    build: ./build
    image: {{ mlflow_image }}
    pull_policy: never
    container_name: fraudstream-mlflow
    restart: unless-stopped
    command:
      - mlflow
      - server
      - --host=0.0.0.0
      - --port=5000
      - --backend-store-uri=postgresql+psycopg2://{{ postgres_user }}:{{ postgres_password }}@fraudstream-postgres:5432/mlflow
      - --artifacts-destination=gs://{{ models_bucket }}/mlflow
      - --serve-artifacts
      - --allowed-hosts=mlflow,mlflow:5000,localhost,localhost:5000,127.0.0.1
    ports:
      - "5000:5000"
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:5000/health')\""]
      interval: 10s
      timeout: 5s
      retries: 30
    networks: [fraudstream]

networks:
  fraudstream:
    external: true
    name: {{ docker_network }}
